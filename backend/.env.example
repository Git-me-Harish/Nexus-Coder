ENV=development

DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000

# Platform-wide fallback keys -- OPTIONAL. Leave blank in a real
# multi-tenant deployment and require each tenant to configure their own
# key via Configure Models in the UI (see app/services/credential_service.py).
# Only set these for solo/dev use where you want a working default without
# per-tenant setup.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEFAULT_MODEL_ID=claude-sonnet-5

# Required before any user can save a provider API key through Configure
# Models -- this encrypts those keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

RATE_LIMIT_PER_MINUTE=60

# Agent execution
# With this on, the agent can RUN the code it writes: the implementation,
# debug, and review phases get a run_command tool. That is what lets it prove
# the tests pass instead of asserting they would.
#
# Execution only ever happens inside Docker -- offline, non-root, read-only
# root filesystem, with the session workspace as the sole writable mount. If
# Docker is unavailable the tool reports an error; it never falls back to
# running generated code on the host. Before enabling, build the image:
#
#   docker build -t nexus-sandbox:latest backend/sandbox/
#
# Leaving it false is safe: the agent still writes files, it just cannot
# execute anything, and it is told so.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=nexus-sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=30

# Per-session working copies the sandbox mounts. Files are also mirrored into
# Postgres (SessionFile), which is the durable record -- so this directory is
# safe to wipe and is not assumed to survive a redeploy.
WORKSPACE_ROOT=./.nexus-workspaces

# GitHub OAuth App
# Powers BOTH "Continue with GitHub" on the login screen and the Review
# phase's "push to GitHub" -- one OAuth App serves both, because a GitHub
# OAuth App has exactly one Authorization callback URL. Register one at
# github.com/settings/developers with:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8000/api/integrations/github/callback
# Left unset, both flows return a clear "not configured" error instead of a
# broken redirect; nothing else in the app depends on them.
# GITHUB_CLIENT_ID=<your GitHub OAuth App Client ID>
# GITHUB_CLIENT_SECRET=<your GitHub OAuth App Client Secret>
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback

# Where the OAuth callback sends the browser back to.
FRONTEND_BASE_URL=http://localhost:3000

# Outbound email (password reset)
# Leave SMTP_HOST empty in development: the reset flow stays fully functional
# and the link is written to the SERVER LOG instead of being emailed (search
# the log for "EMAIL (dev fallback)"). That fallback refuses to run when
# ENV=production, so a deploy that forgets to configure mail fails loudly
# rather than silently dropping every reset email.
#
# For Gmail use smtp.gmail.com:587 with an App Password, not your account
# password (Google blocks plain password SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Nexus Coder <no-reply@example.com>

# How long an emailed reset link stays valid. Links are also single-use, and
# requesting a new one immediately invalidates the previous.
PASSWORD_RESET_TTL_MINUTES=30

# Profile avatars
# Uploaded profile pictures, served back by this API from /uploads/avatars.
# API_BASE_URL is this server's PUBLIC origin -- it is what stored avatar URLs
# are built against, so behind a proxy or a real domain it must be set to the
# hostname browsers actually reach.
UPLOAD_ROOT=./.nexus-uploads
MAX_AVATAR_BYTES=2097152
API_BASE_URL=http://localhost:8000
