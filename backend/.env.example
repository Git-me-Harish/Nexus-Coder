ENV=development

DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000

# Platform-wide fallback keys -- OPTIONAL. Leave blank in a real
# multi-tenant deployment and require each tenant to configure their own
# key via Configure Models in the UI (see app/services/credential_service.py).
# Only set these for solo/dev use where you want a working default without
# per-tenant setup.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEFAULT_MODEL_ID=claude-sonnet-4-6

# Required before any user can save a provider API key through Configure
# Models -- this encrypts those keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

RATE_LIMIT_PER_MINUTE=60

SANDBOX_ENABLED=false
SANDBOX_IMAGE=nexus-sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=30
